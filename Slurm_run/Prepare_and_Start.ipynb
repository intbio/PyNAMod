   "id": "30b698d4-7b7e-429e-84f5-e4ef15acca85",
   "metadata": {},
   "outputs": [],
   "source": [
    "with open('run.sh','r') as f:\n",
    "    bp = f.read()\n",
    "for t_file,f_file in zip(traj_files,fiber_files):\n",
    "    with open(f'MC_1_run_files/run_{f_file[-12:-3]}.sh','w') as f:\n",
    "        f.write(bp[:-8]+ f'{t_file} --h5file {f_file}')"
   ]
  },
